  "scripts": {
    "start": "expo start --clear",
    "start:light": "EXPO_PUBLIC_AIRPAY_THEME=light expo start --clear",
    "start:dark": "EXPO_PUBLIC_AIRPAY_THEME=dark expo start --clear",
